# Nusxa oling: cp .env.example .env.local va qiymatlarni o‘zgartiring
ADMIN_PASSWORD=bu-yerga-kuchli-parol
# Yaratish: node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"hex\"))"
ADMIN_SESSION_SECRET=kamida-32-belgili-tasodifiy-satr

# Premium access va urinish tokenlari imzosi — production'da majburiy (kamida 32 belgi)
ACCESS_TOKEN_SECRET=kamida-32-belgili-boshqa-tasodifiy-satr
# To'lov provayderi. Development'da bo'sh bo'lsa "mock" ishlaydi; production'da mock HECH QACHON yoqilmaydi.
# Haqiqiy provayder (click/payme) ulanmaguncha production'da bo'sh qoldiring — docs/ARCHITECTURE.md §2.4
PAYMENT_PROVIDER=

# Supabase (testlar bazasi va import) — FAQAT server. Hech qachon NEXT_PUBLIC_ bilan boshlamang.
# Bo'sh bo'lsa: sayt kod ichidagi testlar bilan ishlaydi, admin import faqat preview qiladi.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Faqat development: Supabase o'rniga lokal PostgreSQL (PGlite, .data/pglite — git va deploy'ga tushmaydi).
# Production'da e'tiborsiz qoldiriladi.
# LOCAL_DB=pglite
